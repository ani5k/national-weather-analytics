# Copy this file to .env and fill in your real values.
# .env itself is git-ignored so your credentials are never committed.

# Get this from MongoDB Atlas: Database > Connect > Drivers > Python
# Either name works — the API accepts both.
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>/?retryWrites=true&w=majority
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/?retryWrites=true&w=majority

# Must match what the collectors write to (scheduled_validated.py etc.)
DB_NAME=weather_db
COLLECTION_NAME=weather_data

# Kafka / Redpanda (optional — worker falls back to Mongo poll)
KAFKA_BOOTSTRAP=127.0.0.1:19092
KAFKA_TOPIC=weather.raw

# Optional: OpenWeatherMap key for collector scripts
# OPENWEATHER_API_KEY=

# Comma-separated browser origins allowed to call the API
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
